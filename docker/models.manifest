# Loovie Community reference server, model manifest.
#
# Tab-separated.  Lines starting with '#' are comments. Fields:
#   kind         : "image", "video" or "music", selected via LOOVIE_KIND.
#   hf_repo      : HuggingFace repo.
#   hf_path      : path-in-repo (may include subdirs, e.g. split_files/...).
#   local_name   : filename under target_subdir after download (ComfyUI name).
#   target_subdir: ComfyUI folder name (diffusion_models, checkpoints,
#                  text_encoders, vae, loras, upscale_models, latent_upscale_models).
#   model        : optional model id from config.yaml. When LOOVIE_MODELS is set
#                  (comma-separated), rows for other models are skipped. A row
#                  with no model id is part of the legacy kind bundle.
#
# Some entries are GATED on HuggingFace, accept the licence on the HF web
# UI while logged in before the download will succeed. See
# docs/25-huggingface-and-gated-models.md.
#
# Repo paths mirror apps/comfy/scripts/install.sh (FLUX.2 Klein + LTX 2.3 subset).
# RealESRGAN: install.sh lists ai-forever/Real-ESRGAN but that repo has no
# RealESRGAN_x2plus.pth; 2kpr/Real-ESRGAN hosts the file the pro workflows expect.
#
# kind	hf_repo	hf_path	local_name	target_subdir	model

# --- Image: FLUX.2 Klein (~24 GB) ------------------------------------------
image	black-forest-labs/FLUX.2-klein-4B	flux-2-klein-4b.safetensors	flux-2-klein-4b.safetensors	diffusion_models	flux-2-klein
image	Comfy-Org/flux2-dev	split_files/vae/flux2-vae.safetensors	flux2-vae.safetensors	vae	flux-2-klein
image	Comfy-Org/flux2-klein-4B	split_files/text_encoders/qwen_3_4b.safetensors	qwen_3_4b_flux2.safetensors	text_encoders	flux-2-klein

# --- Image: MiniMax H3 Image (~37 GB, shares the H3 text encoder) -----------
# INT8 DiT + image VAE from the Comfy-Org repack; the Qwen3-VL-32B text encoder
# is the one the Pika H3 Flex / HyperFlow rows already pull, so a server that
# runs both families downloads it once.
image	Comfy-Org/MiniMax-H3-Image	diffusion_models/minimax_h3_image_pruned_int8_convrot.safetensors	minimax_h3_image_pruned_int8_convrot.safetensors	diffusion_models	minimax-h3-image
image	Comfy-Org/MiniMax-H3-Image	vae/minimax_h3_image_vae_fp16.safetensors	minimax_h3_image_vae_fp16.safetensors	vae	minimax-h3-image
image	Comfy-Org/MiniMax-H3	text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors	qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors	text_encoders	minimax-h3-image

# --- Video: LTX-2.3 (~70 GB) ------------------------------------------------
video	Comfy-Org/ltx-2	split_files/text_encoders/gemma_3_12B_it_fp8_scaled.safetensors	gemma_3_12B_it_fp8_scaled.safetensors	text_encoders	ltx-2.3
video	Lightricks/LTX-2.3-fp8	ltx-2.3-22b-dev-fp8.safetensors	ltx-2.3-22b-dev-fp8.safetensors	checkpoints	ltx-2.3
video	Lightricks/LTX-2.3	ltx-2.3-22b-distilled-lora-384.safetensors	ltx-2.3-22b-distilled-lora-384.safetensors	loras	ltx-2.3
video	Lightricks/LTX-2.3	ltx-2.3-spatial-upscaler-x2-1.1.safetensors	ltx-2.3-spatial-upscaler-x2-1.1.safetensors	latent_upscale_models	ltx-2.3
video	2kpr/Real-ESRGAN	RealESRGAN_x2plus.pth	RealESRGAN_x2plus.pth	upscale_models	ltx-2.3

