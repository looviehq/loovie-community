# Loovie Community reference server, model manifest.
#
# Tab-separated.  Lines starting with '#' are comments. Fields:
#   kind         : "image" or "video", selected via LOOVIE_KIND.
#   hf_repo      : HuggingFace repo.
#   hf_path      : path-in-repo (may include subdirs, e.g. split_files/...).
#   local_name   : filename under target_subdir after download (ComfyUI name).
#   target_subdir: ComfyUI folder name (diffusion_models, checkpoints,
#                  text_encoders, vae, loras, upscale_models, latent_upscale_models).
#
# Some entries are GATED on HuggingFace, accept the licence on the HF web
# UI while logged in before the download will succeed. See
# docs/25-huggingface-and-gated-models.md.
#
# Repo paths mirror apps/comfy/scripts/install.sh (image + LTX 2.5 subset).
# RealESRGAN: install.sh lists ai-forever/Real-ESRGAN but that repo has no
# RealESRGAN_x2plus.pth; 2kpr/Real-ESRGAN hosts the file the pro workflows expect.
#
# kind	hf_repo	hf_path	local_name	target_subdir

# --- Image: FLUX 3 Image Klein (~11 GB) + MOSS-Image (~13 GB) ---------------
image	black-forest-labs/flux-3-image-klein-comfy	diffusion_models/flux3-image-klein-int8-convrot.safetensors	flux3-image-klein-int8-convrot.safetensors	diffusion_models
image	black-forest-labs/flux-3-image-klein-comfy	text_encoders/qwen3vl_4b_int8_convrot.safetensors	qwen3vl_4b_int8_convrot.safetensors	text_encoders
image	black-forest-labs/flux-3-image-klein-comfy	vae/flux2-vae.safetensors	flux2-vae.safetensors	vae
image	Comfy-Org/MOSS-Image	diffusion_models/moss_image_sft_int8_convrot.safetensors	moss_image_sft_int8_convrot.safetensors	diffusion_models
image	Comfy-Org/MOSS-Image	text_encoders/qwen3.5_9b_w4a8_gptq.safetensors	qwen3.5_9b_w4a8_gptq.safetensors	text_encoders
image	Comfy-Org/MOSS-Image	vae/flux2-vae_small.safetensors	flux2-vae_small.safetensors	vae

# --- Video: LTX-2.5 distilled, ComfyUI int8 (~40 GB) -------------------------
# Lightricks/LTX-2.5 is GATED, accept the licence on the repo page first.
video	Lightricks/LTX-2.5	diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors	ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors	diffusion_models
video	Lightricks/LTX-2.5	text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors	gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors	text_encoders
video	Lightricks/LTX-2.5	vae/ltx-2.5-video-vae-bf16.safetensors	ltx-2.5-video-vae-bf16.safetensors	vae
video	Lightricks/LTX-2.5	vae/ltx-2.5-audio-vae-bf16.safetensors	ltx-2.5-audio-vae-bf16.safetensors	vae
video	Lightricks/LTX-2.5	latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors	ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors	latent_upscale_models
video	2kpr/Real-ESRGAN	RealESRGAN_x2plus.pth	RealESRGAN_x2plus.pth	upscale_models

# --- Music: YuE2 (~3.7 GB) ---------------------------------------------------
music	Comfy-Org/YuE2	checkpoints/yue2_3b_int8_convrot.safetensors	yue2_3b_int8_convrot.safetensors	checkpoints
