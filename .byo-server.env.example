# Copy to .byo-server.env (gitignored) and adjust for your machine.
# `make start|stop|restart|status|logs` reads this file.

# ComfyUI checkout that runs the server.
COMFY_DIR=/path/to/ComfyUI

# Python that has ComfyUI's dependencies installed. Leave unset to use
# $COMFY_DIR/.venv/bin/python, then python3.
#COMFY_PYTHON=/path/to/ComfyUI/.venv/bin/python

# Bind address and port the app points at.
HOST=0.0.0.0
PORT=8188

# Where to append server output. Defaults to /tmp/loovie-comfy-$PORT.log.
#LOG=/tmp/loovie-comfy.log

# Seconds to wait for /loovie/health after starting.
START_TIMEOUT=90
